# Copier en .env pour le développement local. Ne jamais committer le .env.
NODE_ENV=development
PORT=3000

# Base locale. Sur Render, DATABASE_URL est fournie par la base (render.yaml).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cantine_vatel?schema=public

# Secrets JWT : 32 caractères minimum, différents l'un de l'autre.
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=a-remplacer-par-une-longue-chaine-aleatoire-1
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=a-remplacer-par-une-longue-chaine-aleatoire-2
JWT_REFRESH_EXPIRES_IN=7d

# Origines autorisées (back-office), séparées par des virgules.
CORS_ORIGINS=http://localhost:4200
